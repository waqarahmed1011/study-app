# Google Gemini (free tier): https://aistudio.google.com/apikey
# Leave empty to run in demo mode with canned AI output.
GEMINI_API_KEY=
# Optional: override the model names if Google renames them
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_LITE_MODEL=gemini-3.5-flash-lite

# Supabase (Project Settings -> API). Leave empty to use the local file store
# (single user, no login; fine on your own machine, NOT on Vercel).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
